# 复制到 .env 后按需修改；不要提交 .env 到仓库

# 宿主机端口（8199 已被 comfyui-prompt-studio 占用，故用 8198）
HOST_PORT=8198

# B 房 ComfyUI 上游地址（容器内可达）
# 默认走 A 房 frps 隧道 → B 房 8188 的 cu130 / Z-Image INT8 环境
#  18189 = INT8 主用隧道（约 9.7 s/张）
#  18188 = 备用隧道（同样指向 B 房 8188）
# 若 A、B 房在同一局域网，可直接填 http://<B房内网IP>:8188
# 若 ComfyUI 开了 --auth：http://账号:密码@host.docker.internal:18189
COMFYUI_URL=http://host.docker.internal:18189

# 浏览器侧 ComfyUI Base URL。保持 /comfy 即同源代理，
# 不要把 https 页面指向 http 内网地址（混合内容会被浏览器拦截）。
COMFY_BASE_URL=/comfy

# /api/proxy 额外放行的上游域名（云端 Gemini / GPT / Qwen / Doubao 已在内置白名单）
# 例：PROXY_ALLOWED_ORIGINS=https://api.example.com,https://*.openai.com
PROXY_ALLOWED_ORIGINS=

# 你自己的图片 + 文字目录（挂到容器 /app/userdata，只读）
# 目录里放图片（jpg/png/webp…），可选子目录 images/；
# 文字用同名 .txt，或一个 captions.json：{"IMG_001.jpg":"文字"}
# Unraid 建议：/mnt/user/appdata/ai-pose-gallery-zh/userdata
USERDATA_DIR=./userdata

TZ=Asia/Shanghai
