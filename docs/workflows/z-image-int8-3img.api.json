{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "z_image_turbo_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Z-Image-Turbo INT8 扩散模型" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_3_4b_fp8_mixed.safetensors", "type": "lumina2", "device": "default" },
    "_meta": { "title": "Qwen3-4B 文本编码器" }
  },
  "8": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" },
    "_meta": { "title": "VAE（同时编码三张参考图）" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "portrait_placeholder.png" },
    "_meta": { "title": "#1 人像参考 (Portrait) · 由合成台上传" }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": { "image": "costume_placeholder.png" },
    "_meta": { "title": "#2 服装参考 (Costume) · 由合成台上传" }
  },
  "12": {
    "class_type": "LoadImage",
    "inputs": { "image": "pose_placeholder.png" },
    "_meta": { "title": "#3 姿势参考 (Pose) · 由合成台上传" }
  },
  "3": {
    "class_type": "TextEncodeZImageOmni",
    "inputs": {
      "clip": ["2", 0],
      "prompt": "{{prompt}}",
      "auto_resize_images": true,
      "vae": ["8", 0],
      "image1": ["10", 0],
      "image2": ["11", 0],
      "image3": ["12", 0]
    },
    "_meta": { "title": "三图融合提示词（由合成台注入）" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["2", 0] },
    "_meta": { "title": "Negative (CFG=1 蒸馏模型不生效)" }
  },
  "5": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "_meta": { "title": "输出尺寸 1024×1024" }
  },
  "6": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["1", 0], "shift": 3.0 },
    "_meta": { "title": "AuraFlow shift 3.0" }
  },
  "30": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0],
      "seed": 729703840979498,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0]
    },
    "_meta": { "title": "KSampler 8 步 / CFG 1" }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["30", 0], "vae": ["8", 0] },
    "_meta": { "title": "VAE 解码" }
  },
  "31": {
    "class_type": "SaveImage",
    "inputs": { "images": ["7", 0], "filename_prefix": "three-in-one-int8" },
    "_meta": { "title": "保存三合一结果" }
  }
}
